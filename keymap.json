// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Workspace",
    "bindings": {
      "shift shift": null,
      "ctrl-q h": "workspace::ActivatePaneLeft",
      "ctrl-q j": "workspace::ActivatePaneDown",
      "ctrl-q k": "workspace::ActivatePaneUp",
      "ctrl-q l": "workspace::ActivatePaneRight",
      // "space c": "workspace::ActivatePane",
    },
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "space l r": "editor::RestartLanguageServer",
      "space c p": "workspace::CopyPath",
      "space c r": "workspace::CopyRelativePath",
      "shift-z z": ["workspace::SendKeystrokes", ":wq\n"],
      "alt-enter": ["workspace::SendKeystrokes", "i enter escape"],
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "space b": "git::Branch",
      "space d": "git::Diff",
      "space a": "git::Blame",
      "space f": "git::BranchDiff",
    },
  },
  {
    "context": "Editor && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "shift-x": "editor::SelectLargerSyntaxNode",
      "й": ["workspace::SendKeystrokes", "q"],
      "ц": ["workspace::SendKeystrokes", "w"],
      "у": ["workspace::SendKeystrokes", "e"],
      "к": ["workspace::SendKeystrokes", "r"],
      "е": ["workspace::SendKeystrokes", "t"],
      "н": ["workspace::SendKeystrokes", "y"],
      "г": ["workspace::SendKeystrokes", "u"],
      "ш": ["workspace::SendKeystrokes", "i"],
      "щ": ["workspace::SendKeystrokes", "o"],
      "з": ["workspace::SendKeystrokes", "p"],
      "х": ["workspace::SendKeystrokes", "["],
      "ъ": ["workspace::SendKeystrokes", "]"],
      "ф": ["workspace::SendKeystrokes", "a"],
      "ы": ["workspace::SendKeystrokes", "s"],
      "в": ["workspace::SendKeystrokes", "d"],
      "а": ["workspace::SendKeystrokes", "f"],
      "п": ["workspace::SendKeystrokes", "g"],
      "р": ["workspace::SendKeystrokes", "h"],
      "о": ["workspace::SendKeystrokes", "j"],
      "л": ["workspace::SendKeystrokes", "k"],
      "д": ["workspace::SendKeystrokes", "l"],
      "ж": ["workspace::SendKeystrokes", ";"],
      "э": ["workspace::SendKeystrokes", "'"],
      "я": ["workspace::SendKeystrokes", "z"],
      "ч": ["workspace::SendKeystrokes", "x"],
      "с": ["workspace::SendKeystrokes", "c"],
      "м": ["workspace::SendKeystrokes", "v"],
      "и": ["workspace::SendKeystrokes", "b"],
      "т": ["workspace::SendKeystrokes", "n"],
      "ь": ["workspace::SendKeystrokes", "m"],
      "б": ["workspace::SendKeystrokes", ","],
      "ю": ["workspace::SendKeystrokes", "."],

      "shift-й": ["workspace::SendKeystrokes", "Q"],
      "shift-ц": ["workspace::SendKeystrokes", "W"],
      "shift-у": ["workspace::SendKeystrokes", "E"],
      "shift-к": ["workspace::SendKeystrokes", "R"],
      "shift-е": ["workspace::SendKeystrokes", "T"],
      "shift-н": ["workspace::SendKeystrokes", "Y"],
      "shift-г": ["workspace::SendKeystrokes", "U"],
      "shift-ш": ["workspace::SendKeystrokes", "I"],
      "shift-щ": ["workspace::SendKeystrokes", "O"],
      "shift-з": ["workspace::SendKeystrokes", "P"],
      "shift-х": ["workspace::SendKeystrokes", "{"],
      "shift-ъ": ["workspace::SendKeystrokes", "}"],
      "shift-ф": ["workspace::SendKeystrokes", "A"],
      "shift-ы": ["workspace::SendKeystrokes", "S"],
      "shift-в": ["workspace::SendKeystrokes", "D"],
      "shift-а": ["workspace::SendKeystrokes", "F"],
      "shift-п": ["workspace::SendKeystrokes", "G"],
      "shift-р": ["workspace::SendKeystrokes", "H"],
      "shift-о": ["workspace::SendKeystrokes", "J"],
      "shift-л": ["workspace::SendKeystrokes", "K"],
      "shift-д": ["workspace::SendKeystrokes", "L"],
      "shift-ж": ["workspace::SendKeystrokes", ":"],
      "shift-э": ["workspace::SendKeystrokes", "\""],
      "shift-я": ["workspace::SendKeystrokes", "Z"],
      "shift-ч": ["workspace::SendKeystrokes", "X"],
      "shift-с": ["workspace::SendKeystrokes", "C"],
      "shift-м": ["workspace::SendKeystrokes", "V"],
      "shift-и": ["workspace::SendKeystrokes", "B"],
      "shift-т": ["workspace::SendKeystrokes", "N"],
      "shift-ь": ["workspace::SendKeystrokes", "M"],
      "shift-б": ["workspace::SendKeystrokes", "<"],
      "shift-ю": ["workspace::SendKeystrokes", ">"],
    },
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      // "j k": "vim::NormalBefore"
      "ctrl-h": "editor::MoveLeft",
      "ctrl-j": "editor::MoveDown",
      "ctrl-k": "editor::MoveUp",
      "ctrl-l": "editor::MoveRight",
    },
  },
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space s": "file_finder::Toggle",
      "space f": "pane::DeploySearch",
      "w": "vim::NextSubwordStart",
      "W": "vim::NextWordStart",
      "b": "vim::PreviousSubwordStart",
      "B": "vim::PreviousWordStart",
      "e": "vim::NextSubwordEnd",
      "E": "vim::NextWordEnd",
      "g e": "vim::PreviousSubwordEnd",
      "g E": "vim::PreviousWordEnd",
      "space o": "projects::OpenRecent",
      "space q q": "pane::CloseActiveItem",
      "ctrl-w": "pane::CloseActiveItem",
      "space q o": "pane::CloseOtherItems",
      "space q a": "pane::CloseAllItems",
      "space e": "pane::RevealInProjectPanel",
      "U": "editor::Redo",
      "ctrl-j": "editor::MoveLineDown",
      "ctrl-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "VisualMode && !menu",
    "bindings": {
      "ctrl-j": "editor::MoveLineDown",
      "ctrl-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "vim_operator == a || vim_operator == i",
    "bindings": {
      "w": "vim::Subword",
      "W": "vim::Word",
    },
  },
  {
    "context": "Editor && mode == single_line",
    "bindings": {
      "ctrl-h": "editor::MoveLeft",
      "ctrl-l": "editor::MoveRight",
      "ctrl-k": "editor::MoveToBeginningOfLine",
      "ctrl-j": "editor::MoveToEndOfLine",
      "alt-h": "editor::MoveToPreviousSubwordStart",
      "alt-l": "editor::MoveToNextSubwordEnd",
      "ctrl-w": "editor::DeleteToPreviousSubwordStart",
    },
  },
  {
    "context": "menu",
    "bindings": {
      "ctrl-n": "menu::SelectNext",
      "ctrl-p": "menu::SelectPrevious",
      "ctrl-y": "menu::Confirm",
    },
  },
  {
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-n": "editor::ContextMenuNext",
      "ctrl-p": "editor::ContextMenuPrevious",
      "ctrl-y": "editor::ConfirmCompletion",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-7": ["pane::ActivateItem", 6],
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-7": ["workspace::ActivatePane", 6],
    },
  },
  {
    "context": "OutlinePanel",
    "bindings": {
      "alt-4": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "OutlinePanel",
    "unbind": {
      "alt-7": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Pane",
    "bindings": {
      "alt-4": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "Pane",
    "unbind": {
      "alt-7": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-4": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "alt-7": "outline_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "alt-7": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Workspace || Editor",
    "unbind": {
      "alt-f12": "terminal_panel::Toggle",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-7": "workspace::CloseActiveDock",
    },
  },
  {
    "context": "Terminal",
    "unbind": {
      "alt-f12": "workspace::CloseActiveDock",
    },
  },
]
